# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Assignment brief — not ours to publish
docs/assignment.pdf

# Node
node_modules/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Automation runtime junk
playwright-report/
test-results/
.playwright/

# Run evidence — the output of a run, not source. The directory is tracked so
# a run has somewhere to write; the per-run JSONL is not.
evidence/*
!evidence/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/

# SDD scratch workspace
.superpowers/

# Screen recordings of runs. `docs/demo/discovery-run.webm` is committed
# deliberately as the project's one demonstration asset; further recordings are
# scratch and stay out.
docs/demo/*
!docs/demo/discovery-run.webm
